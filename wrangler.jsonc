// Cloudflare Worker settings for this site.
// The whole site is index.html (plus manifest.webmanifest), served as static files.
// Deploy command in Cloudflare: npx wrangler deploy   (no build command)
{
  "name": "dobytoday",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./"
  }
}
